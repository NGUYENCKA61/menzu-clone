# Postgres connection for the menzu.lol clone.
# Copy this file to `.env` and fill in your own password.
#
#   createdb -U postgres menzu_clone
#
DATABASE_URL="postgresql://postgres:thichthihack@localhost:5432/menzu_clone?schema=public"

# Canonical origin used for sitemap.xml, robots.txt, canonical tags and Open
# Graph URLs. No trailing slash. On Vercel this falls back to VERCEL_URL.
NEXT_PUBLIC_SITE_URL="https://menzu-clone.vercel.app"
