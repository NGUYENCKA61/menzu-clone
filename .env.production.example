# Copy this to `.env` on the VPS and fill it in. Never commit the real .env —
# it is gitignored and dockerignored on purpose.
#
#   cp .env.production.example .env
#   nano .env
#
# The three REQUIRED values must be set or the stack will not come up.

# ── REQUIRED ────────────────────────────────────────────────────────────────

# The database password. Pick a long random one; it is used by the postgres
# container AND must match the password inside DATABASE_URL below.
POSTGRES_PASSWORD=doi-thanh-mat-khau-that-dai-va-ngau-nhien

# How the app reaches Postgres. Host is `postgres` (the compose service name),
# not localhost. Keep user/db as `menzu` unless you change POSTGRES_USER/DB.
DATABASE_URL=postgresql://menzu:doi-thanh-mat-khau-that-dai-va-ngau-nhien@postgres:5432/menzu?schema=public

# The site's real public address, WITH https and no trailing slash. Baked into
# the build, so a wrong value here freezes every canonical/OG/sitemap URL and
# Google de-indexes the site. Rebuild the image if you change it.
NEXT_PUBLIC_SITE_URL=https://thichthihack.com

# ── OPTIONAL ────────────────────────────────────────────────────────────────

# Defaults are fine; only set these to override.
# POSTGRES_USER=menzu
# POSTGRES_DB=menzu
# PORT=3000

# Where uploaded images and videos live on the host. Caddy serves this folder
# directly (deploy/Caddyfile has the same path), so it must sit somewhere the
# caddy user can read — not under /root. Defaults to ./uploads next to this
# file if unset.
UPLOADS_DIR=/var/www/menzu/uploads

# The AI support assistant. Leave both unset to keep it off (the panel just
# shows the Messenger/Zalo buttons). ASSISTANT_MODEL defaults to claude-opus-5;
# claude-haiku-4-5 is far cheaper and plenty for support chat.
# ANTHROPIC_API_KEY=sk-ant-...
# ASSISTANT_MODEL=claude-haiku-4-5

# Note: SMTP, Telegram, Facebook/Zalo links and Turnstile are configured in the
# admin panel (Cấu hình), not here — they live in the database, not the env.
