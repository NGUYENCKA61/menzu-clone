// Data model for the menzu.lol clone.
//
// Every table below is shaped by something observed on the live site, not by
// convention. The notes say which observation forced which decision, because
// several of them are not what you would guess from the UI alone.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 no longer accepts `url` here — the connection string lives in
// prisma.config.ts for migrations, and the client gets a driver adapter.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Users & auth
// ---------------------------------------------------------------------------

enum UserRole {
  MEMBER
  /// Đại lý — granted by an admin, never self-served. Buys software keys at
  /// their own negotiated `agencyPercent` through /agency/dashboard.
  AGENCY
  ADMIN
}

enum MemberTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

model User {
  id           String     @id @default(cuid())
  /// Shown as "UID: 10049" on /profile — a short public number, not the PK.
  uid          Int        @unique @default(autoincrement())
  username     String     @unique
  email        String?    @unique
  passwordHash String?
  avatarUrl    String?
  role         UserRole   @default(MEMBER)
  /// Address seen at the last successful sign-in, for support lookups.
  /// Best-effort: it comes from a proxy header, so treat it as a hint.
  lastIp       String?
  lastLoginAt  DateTime?

  /// When set, the account is blocked: it cannot sign in and any live
  /// session stops resolving. A timestamp rather than a boolean so the
  /// admin list can say when it happened without a second table.
  blockedAt    DateTime?
  /// Shown to the admin who blocked it, and to nobody else.
  blockedReason String?
  tier         MemberTier @default(BRONZE)

  /// Purchases are debited from this balance — the checkout dialog has no card
  /// entry, only "Số dư ví hiện tại" and "Cần nạp thêm".
  balance      BigInt     @default(0)
  /// "Điểm thưởng … Pts" on /profile.
  points       Int        @default(0)

  /// The đại lý's negotiated wholesale percent, typed by the admin when the
  /// role is granted and zeroed when it is revoked. Per account and shown to
  /// nobody else — the shop deliberately publishes no flat rate.
  agencyPercent Int @default(0)

  /// "Số tiền hoa hồng khả dụng": referral earnings waiting to be moved into
  /// `balance`. Kept apart from balance so the shop can see referral money
  /// as its own stream before it is spent.
  commissionBalance BigInt @default(0)
  /// Who shared the /register?ref= link this account signed up through.
  /// Set once at registration and never rewritten.
  referredById String?
  referredBy   User?   @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals    User[]  @relation("Referrals")
  /// Commission this user earned from their referrals' top-ups…
  referralEarnings ReferralEarning[] @relation("EarnedBy")
  /// …and the earnings this user's own top-ups generated for their referrer.
  referralSources  ReferralEarning[] @relation("EarnedFrom")

  createdAt    DateTime   @default(now())

  sessions      Session[]
  linkedAccounts LinkedAccount[]
  orders        Order[]
  transactions  Transaction[]
  spinWins      SpinWin[]
  tradeRequests TradeRequest[]
  topUps        TopUp[]
  serviceOrders ServiceOrder[]
  announcements AnnouncementRecipient[]
  cartItems     CartItem[]
  passwordResets PasswordReset[]
  feedbacks     Feedback[]
  licenseKeys   LicenseKey[]

  @@map("users")
}

/// One referred top-up's commission (REFERRAL_PERCENT in lib/referral.ts) —
/// written in the same transaction that credits the top-up itself. `topUpId`
/// is unique so a replayed settle can never pay the same commission twice.
model ReferralEarning {
  id         String   @id @default(cuid())
  /// The referrer the money went to.
  userId     String
  user       User     @relation("EarnedBy", fields: [userId], references: [id], onDelete: Cascade)
  /// The referred customer whose top-up paid it.
  fromUserId String
  fromUser   User     @relation("EarnedFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  topUpId    String   @unique
  topUp      TopUp    @relation(fields: [topUpId], references: [id], onDelete: Cascade)
  amount     BigInt
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@map("referral_earnings")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  /// What and where signed in — the "Quản lý thiết bị" list. All nullable:
  /// rows predate these columns, and a proxyless request may carry no IP.
  ip        String?
  userAgent String?
  /// "Thốt Nốt, Vietnam" — resolved once after sign-in, fire-and-forget.
  location  String?

  @@index([userId])
  @@map("sessions")
}

enum TradeMode {
  /// "Thanh lý thu tiền" — sell the account for cash.
  SELL
  /// "Thu cũ đổi mới" — trade it against another account on the shop.
  EXCHANGE
}

enum TradeMailType {
  /// Original mailbox still attached and handed over.
  DROP
  /// Original mailbox lost, but the linked email can still be changed.
  DEAD
}

enum TradeStatus {
  PENDING
  QUOTED
  ACCEPTED
  REJECTED
  DONE
}

/// A "Thu cũ đổi mới" request: the visitor offers an account and asks for a
/// quote, which an admin answers over Zalo.
///
/// The quote itself is not modelled as money yet — pricing a second-hand
/// account is a judgement call the shop makes per request, and inventing a
/// formula would be worse than leaving the field for a human.
model TradeRequest {
  id            String        @id @default(cuid())
  /// Short public reference the visitor quotes to support.
  code          String        @unique
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode          TradeMode
  mailType      TradeMailType
  hasWelcomeMail Boolean      @default(false)
  /// Screenshot of the Riot welcome mail, if one was attached.
  screenshotUrl String?
  zalo          String
  note          String?
  status        TradeStatus   @default(PENDING)
  /// Filled in by an admin once the account has been valued.
  quotedAmount  BigInt?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt @default(now())

  @@index([userId, createdAt])
  @@map("trade_requests")
}

enum DocCategory {
  FAQ
  WARRANTY
  GUIDE
}

/// A wiki article listed on /docs and rendered at /docs/[slug].
///
/// `body` is nullable because only the index was captured: the listing carries
/// each article's title, date and view count, but the prose lives on its own
/// page. An article without a body renders an explicit empty state instead of
/// invented copy.
model DocArticle {
  id           String      @id @default(cuid())
  slug         String      @unique
  title        String
  category     DocCategory
  excerpt      String?
  body         String?
  thumbnailUrl String
  views        Int         @default(0)
  publishedAt  DateTime
  sortOrder    Int         @default(0)
  updatedAt    DateTime    @updatedAt @default(now())

  @@index([category, sortOrder])
  @@map("doc_articles")
}

/// Owner card shown at the top of /bio. One row.
model BioProfile {
  id        String     @id @default(cuid())
  name      String
  tagline   String?
  avatarUrl String
  updatedAt DateTime   @updatedAt @default(now())
  links     BioLink[]

  @@map("bio_profiles")
}

/// A contact button on /bio.
///
/// These are data, not markup: they carry a real person's name, phone number
/// and social handles, and they change without a deploy. `page` drives the
/// two-panel carousel the live card slides between.
model BioLink {
  id         String     @id @default(cuid())
  profileId  String
  profile    BioProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  label      String
  sublabel   String?
  url        String
  iconUrl    String
  page       Int        @default(1)
  sortOrder  Int        @default(0)

  @@index([profileId, page, sortOrder])
  @@map("bio_links")
}

/// The mobile app build advertised on /app/download.
///
/// Version, size and date change with every release, so they are data rather
/// than markup. The two download URLs are nullable on purpose: this clone
/// ships no binaries, and a button pointing at a file that does not exist is
/// worse than one that says so.
model AppRelease {
  id           String   @id @default(cuid())
  version      String
  buildNumber  Int
  sizeLabel    String
  releasedAt   DateTime
  minAndroid   String
  minIos       String
  androidUrl   String?
  iosUrl       String?
  updatedAt    DateTime @updatedAt @default(now())

  @@map("app_releases")
}

enum AuthAttemptKind {
  LOGIN
  REGISTER
  RESET
}

/// Throttling ledger for the credential endpoints, kept only long enough to
/// enforce a window.
///
/// This lives in the database rather than in process memory because serverless
/// deployments spread requests across instances that share no state — an
/// in-memory counter there caps nothing.
///
/// LOGIN rows are written only on failure, so a healthy sign-in costs no extra
/// write. REGISTER rows are written on every success, because the thing being
/// limited there is account creation itself.
model AuthAttempt {
  id         String          @id @default(cuid())
  kind       AuthAttemptKind
  /// The username or email that was tried, lowercased. Never the password.
  identifier String
  /// Best-effort client address; spoofable unless a trusted proxy sets it,
  /// which is why the per-identifier limit is the real protection.
  ip         String
  createdAt  DateTime        @default(now())

  @@index([kind, identifier, createdAt])
  @@index([kind, ip, createdAt])
  @@map("auth_attempts")
}

/// One question put to the AI assistant, kept as a counter and nothing else.
///
/// No message text: the ledger exists to cap how many questions one visitor
/// can ask in an hour — the shop pays per answer — and storing what customers
/// typed would be keeping their words for a job that only needs a count.
///
/// Pruned opportunistically on write, like the auth ledger, so no cron job is
/// needed to keep it from growing forever.
model AssistantHit {
  id     String @id @default(cuid())
  /// Best-effort client address; spoofable, which is why a signed-in visitor
  /// is also capped by account.
  ip     String
  userId String?
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([userId, createdAt])
  @@map("assistant_hits")
}

/// "Liên kết nền tảng" on /profile — Discord carries a "Thưởng 1.000 Pts" bonus.
/// One outstanding "quên mật khẩu" link. The token itself never lands here —
/// only its SHA-256 — so a database read cannot mint a working link.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  /// Set the moment the link is spent; a used link never works twice.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_resets")
}

model LinkedAccount {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String
  providerId String
  createdAt  DateTime @default(now())

  @@unique([provider, providerId])
  @@index([userId])
  @@map("linked_accounts")
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

/// A row of category tiles on the home page: "Hot trending tháng này",
/// "Danh sách game", and whatever else the shop wants to build.
///
/// A group owns no categories of its own. It points at the ones that already
/// exist, which is the whole reason this table is here: a category belongs to
/// as many groups as the shop likes and stays one row with one product list,
/// one stock count and one URL. Putting a game in a second group adds a line
/// to group_categories and nothing else.
///
/// This used to be a comma-separated string of slugs in the settings table,
/// one key per row, with the rows themselves hard-coded. That could not add a
/// group without a deploy, and nothing stopped a slug in it from naming a
/// category that had been deleted.
model Group {
  id        String          @id @default(cuid())
  slug      String          @unique
  /// The heading, as it appears on the home page. Any icon beside it is a
  /// Lucide glyph mapped by slug in code — the admin-typed emoji column this
  /// model used to carry is gone by the shop's decision.
  name      String
  sortOrder Int             @default(0)
  /// Off keeps the group and its links but stops rendering the row.
  isActive  Boolean         @default(true)
  updatedAt DateTime        @updatedAt @default(now())
  categories GroupCategory[]

  @@map("groups")
}

/// The N:N between a group and the categories it shows.
///
/// `sortOrder` is per group, so the same category can lead one row and come
/// last in another. The unique pair is what stops a category being added to
/// the same group twice.
model GroupCategory {
  id         String   @id @default(cuid())
  groupId    String
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  sortOrder  Int      @default(0)

  @@unique([groupId, categoryId])
  @@index([groupId, sortOrder])
  @@map("group_categories")
}

/// One logo in the "Đối tác uy tín" strip on the home page.
///
/// A table rather than a settings blob: partners are added and retired one at
/// a time from the admin, and each carries its own artwork upload — the same
/// reasons categories are rows. The strip hides itself while this is empty,
/// so nothing here is seeded with invented names.
model Partner {
  id        String   @id @default(cuid())
  name      String
  /// The small grey line under the logo — "Ví điện tử", "Ngân hàng". Null
  /// draws the tile without it.
  tagline   String?
  /// Null renders the name as text in place of artwork.
  logoUrl   String?
  /// Where clicking the logo goes. Null renders a plain tile.
  url       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("partners")
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  /// One or two lines under the name on the home page tile — what this
  /// category actually sells, in the shop's own words. Null draws the tile
  /// without the line rather than leaving a blank gap where it would be.
  description String?
  /// "PC", "MOBILE" or "SPOOFER" — the chip the home page's game list can be
  /// narrowed by. Text checked against src/lib/categoryPlatform.ts rather
  /// than an enum, so a fourth kind is a one-line change and not a
  /// migration. Null sits under "Tất cả" only.
  platform  String?
  sortOrder Int       @default(0)
  imageUrl  String?
  soldCount Int       @default(0)
  stockCount Int      @default(0)
  /// Feeds sitemap.xml's <lastmod>. Stamping every entry with "now" instead
  /// teaches crawlers the field is noise and they stop honouring it.
  updatedAt DateTime  @updatedAt @default(now())
  products  Product[]
  /// Which rows show this category. Deleting the category takes its links
  /// with it; it never takes the group.
  groups    GroupCategory[]

  @@map("categories")
}

enum ProductStatus {
  AVAILABLE
  RESERVED
  SOLD
  HIDDEN
}

/// Which of the two things a product row describes.
///
/// One table rather than two. A category, a group, an order, a voucher, a
/// flash sale and every admin screen already point at "a product"; splitting
/// the row in two would have meant duplicating all of those relations and
/// then teaching each caller which of the two to look in. The discriminator
/// decides which of the two field sets below carries meaning — the other is
/// left null, and nothing reads it.
enum ProductType {
  ACCOUNT_GAME
  SOFTWARE_GAME
}

/// The detection state a tool advertises, shown as the pill above its title.
///
/// It is the first thing a buyer looks for and the reason they leave, so it is
/// a field rather than a line of description text: it has to be filterable and
/// changeable in one edit when a game patch lands.
enum SoftwareStatus {
  UNDETECTED
  DETECTED
  UPDATING
}

/// One purchasable game account. `code` is the public identifier shown as
/// "#VLR2030" and used in the /account/[code] URL.
model Product {
  id         String        @id @default(cuid())
  code       String        @unique
  /// The product's half of its public address: /{category.slug}/{slug}.
  ///
  /// Unique across the shop, not merely within a category, so a product has
  /// exactly one canonical URL and can still be found by slug alone when an
  /// old address has to be redirected to it. The code stays what the shop and
  /// its orders call the row; this is what a customer sees.
  slug       String        @unique
  categoryId String
  category   Category      @relation(fields: [categoryId], references: [id])

  /// Decides which of the two field blocks below applies. Defaulted so every
  /// row that existed before this column keeps meaning exactly what it did.
  productType ProductType  @default(ACCOUNT_GAME)

  /// Shown as the product's title. Accounts are known by their `code` and
  /// leave this null; software carries a real name — "Valorant Tool Premium".
  name       String?
  /// The paragraph under the title. Software only, in practice.
  description String?
  /// "Tính năng nổi bật", as a JSON array of {title, body}.
  ///
  /// One column rather than a child table because the list is written and read
  /// whole — nothing counts it, joins it or asks for one row of it, which is
  /// what earns `packages` and `skins` their own tables. Null means this
  /// product has none of its own and the page prints the shop's default list.
  /// See src/lib/productFeatures.ts.
  features   String?
  /// The write-up under that list, as sanitized editor HTML.
  ///
  /// Its own column rather than more rows in `features`: the list answers
  /// "what does it do", in one line each, and this answers "how", at whatever
  /// length and with whatever pictures the shop wants. Null simply draws
  /// nothing after the bullets.
  featuresNote String?
  /// "Hướng dẫn sử dụng", as sanitized editor HTML.
  ///
  /// Null prints the sentence every tool printed before this column existed —
  /// a shop that has written no guide for a product still tells the buyer
  /// something rather than showing an empty heading.
  guide      String?

  // --- SOFTWARE_GAME ---------------------------------------------------
  /// Null on accounts, where the idea does not apply.
  softwareStatus SoftwareStatus?
  /// Where "Tải tool và hướng dẫn sử dụng" points — an installer, a Drive
  /// folder, a guide, whatever the shop hands out. Null hides the button
  /// rather than rendering one that goes nowhere.
  downloadUrl    String?
  /// A YouTube link for the detail page's main frame. Stored as the shop
  /// pasted it — a watch URL, a share link, a bare id — and turned into an
  /// embed at render time, so nobody has to know what an embed URL looks like.
  /// Null falls the frame back to the picture.
  videoUrl       String?

  // --- ACCOUNT_GAME ----------------------------------------------------
  /// Software rows leave these at their empty or zero values. `rank` stays
  /// required rather than becoming nullable: it is read in a dozen places as
  /// a plain string, and widening the type there would spread null handling
  /// across the storefront to describe a case none of those screens can
  /// reach — a software product never renders an account's stat rows.
  rank       String
  /// "LAST: DIAMOND 1 (V26 // ACT III)" — shown under the current rank.
  lastRank   String?
  trackerUrl String?

  level      Int           @default(0)
  vip        Int           @default(0)
  vipIngame  Int           @default(0)
  kc         Int           @default(0)

  /// "Mail gốc"
  mailType   String?

  /// The account's own sign-in. On an NFA-tagged account it is handed to the
  /// buyer, untouched by anyone, the moment the sale goes through; on any
  /// other tag the shop hands the account over in person and this is only
  /// its own record. Typed by the shop when listing.
  ///
  /// On the product rather than the order because the product IS the account:
  /// there is one sign-in per row, and an order reads it through its join the
  /// way it reads the code and the picture. An account listed without one
  /// sells all the same and hands over nothing — the shop's decision: whatever
  /// else a buyer needs, they ask for. Stored verbatim, like a licence key:
  /// the buyer has to read it back. Both or neither — half a sign-in is
  /// nothing to hand over, and the admin route refuses to store one.
  ///
  /// Never selected by a storefront query. The buyer's own order page and the
  /// admin desk are the two readers, and the first checks the order's status.
  loginUsername String?
  loginPassword String?
  /// Whatever else the buyer needs to take the account over — mail khôi phục,
  /// mã 2FA, "đổi mật khẩu ngay". Plain text, rendered as text.
  loginNote     String?

  /// Prices are whole VND — never floats.
  oldPrice   BigInt
  price      BigInt
  /// "Cọc / Góp — từ 299.000đ"
  depositFrom BigInt?

  status     ProductStatus @default(AVAILABLE)
  imageUrl   String?
  viewers    Int           @default(0)

  /// Totals for the four inventory tabs that carry no per-item data.
  ///
  /// Weapon skins get one ProductSkin row each, because the card needs their
  /// individual tiers for the colour chips. Buddies, agents, cards and sprays
  /// are only ever shown as a count, and the source exposes nothing else about
  /// them — storing hundreds of empty rows per product to be counted back up
  /// would buy nothing. Null means "not scraped yet", and the detail page
  /// falls back to counting rows.
  buddyCount Int?
  agentCount Int?
  cardCount  Int?
  sprayCount Int?

  soldCount  Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt @default(now())

  /// When the shop removed this product. Null means it is live.
  ///
  /// Soft rather than a row delete because orders point at it: `Order.productId`
  /// is required and the relation restricts, so a real delete is refused by the
  /// database the moment an account has been sold once — and forcing it would
  /// strip the code, rank and picture off every past order, since the order row
  /// stores only the money and reads the rest back through this join.
  ///
  /// Every listing filters on `deletedAt: null`; order history deliberately
  /// does not, which is what lets a customer still see what they bought.
  deletedAt  DateTime?

  tags       ProductTag[]
  skins      ProductSkin[]
  orders     Order[]
  flashSales FlashSale[]
  packages   ProductPackage[]
  images     ProductImage[]
  cartItems  CartItem[]

  @@index([categoryId, status])
  @@index([price])
  // Listings ask for one type at a time — a category page splits accounts from
  // software before it renders either.
  @@index([categoryId, productType])
  // Every storefront listing carries `deletedAt: null`, so the common lookups
  // stay on an index rather than filtering the removed rows out afterwards.
  @@index([deletedAt])
  @@map("products")
}

/// "DROP MAIL" and friends — free-form pills on the card.
model ProductTag {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String

  @@index([productId])
  @@map("product_tags")
}

/// The five inventory tabs on /account/[code].
/// IMPORTANT: the card's "42 Skins" headline counts WEAPON_SKIN only — buddies,
/// agents, cards and sprays are separate totals. A single `skins` column on
/// Product would have been wrong.
enum SkinKind {
  WEAPON_SKIN
  BUDDY
  AGENT
  CARD
  SPRAY
}

/// Valorant content tiers, matching the five coloured counters on every card.
enum ContentTier {
  ULTRA // yellow
  EXCLUSIVE // orange
  PREMIUM // pink
  DELUXE // cyan
  SELECT // blue
}

model ProductSkin {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind      SkinKind
  tier      ContentTier?
  name      String
  iconUrl   String?
  /// Weapon the skin belongs to — "Vandal", "Phantom", "Melee" — driving the
  /// filter row above the inventory grid.
  ///
  /// Resolved from valorant-api.com's weapon list rather than parsed out of
  /// the skin name: melee skins like "Equilibrium" and "Heart Splitter" carry
  /// no weapon word at all, so name-matching would silently drop them.
  weapon    String?

  @@index([productId, kind])
  @@map("product_skins")
}

/// One picture per weapon, shared by every account that lists it.
///
/// A library rather than a column on ProductSkin, because the same weapon shows
/// up on dozens of accounts and sourcing its picture once is the whole point:
/// filling it in per row would mean finding the same M200 image again for every
/// account that happens to carry one.
///
/// Joined by text, not by a foreign key. Skin names are typed by hand — there
/// is no weapon table for them to point at — so the name itself is the only
/// thing tying an account's line to a picture.
model WeaponImage {
  id        String   @id @default(cuid())
  /// The lookup key: `name` lowercased with runs of whitespace collapsed, so a
  /// list typed "m200  dominator" still finds the picture saved as "M200
  /// Dominator". Unique, which is what makes saving the same weapon twice an
  /// update rather than a second copy.
  key       String   @unique
  /// As the shop typed it — what the library list shows.
  name      String
  /// Path under /public. Remote pictures are downloaded rather than hotlinked:
  /// a card loading from someone else's CDN is slower, breaks the day they move
  /// the file, and cannot be served by next/image at all without allowing that
  /// host to put anything on the page.
  url       String
  width     Int
  height    Int
  /// Where it was fetched from, kept so an image pasted from a wiki can be told
  /// apart from one uploaded off a disk — and re-fetched if it ever needs to be.
  sourceUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  @@map("weapon_images")
}

/// One purchasable duration of a software product — the "1 ngày / 7 ngày /
/// 30 ngày / Vĩnh viễn" row on its page.
///
/// Rows rather than four columns on Product: shops add tiers and retire them,
/// and a fixed set of columns would need a migration every time one changed.
/// The price lives here because the tier is what it prices; `Product.price`
/// stays the figure a listing card shows before any tier has been chosen.
model ProductPackage {
  id           String  @id @default(cuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Shown verbatim — "1 ngày", "Vĩnh viễn". Written by the shop, because the
  /// wording is part of the offer and deriving it from a day count would lose
  /// the distinction between "30 ngày" and "1 tháng".
  label        String
  /// How long the key lasts, counted in hours because tools sell by the hour
  /// as readily as by the month — a day column could not hold "3 giờ" at all.
  /// Null means it never expires. Drives when a delivered key stops working;
  /// the label is what the buyer reads.
  durationHours Int?
  price        BigInt
  sortOrder    Int     @default(0)
  orders       Order[]
  cartItems    CartItem[]
  /// The tier's own stock of licence keys. Per tier rather than per product:
  /// a one-day key and a lifetime key are different goods, and the shop hands
  /// out whichever one was paid for.
  licenseKeys  LicenseKey[]

  @@index([productId, sortOrder])
  @@map("product_packages")
}

/// A software line a shopper has staged but not paid for.
///
/// Only software reaches this table. An account is one of a kind, so holding
/// one in a basket would either reserve it — starving every other shopper for
/// as long as the tab stayed open — or promise something that could be sold
/// out from under them at checkout. Those still buy straight from their page.
///
/// The unique triple is what makes "add" idempotent: choosing the same tier of
/// the same tool twice raises the quantity instead of stacking a second line.
model CartItem {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  packageId String
  package   ProductPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())

  @@unique([userId, productId, packageId])
  @@index([userId])
  @@map("cart_items")
}

/// Extra screenshots behind the thumbnail strip on a detail page.
///
/// Accounts get one generated asset each and use `Product.imageUrl`; software
/// is sold on what it looks like in use, so it needs several. Kept as its own
/// table rather than a string array so the order is a column that can be
/// changed without rewriting the whole list.
model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int     @default(0)

  @@index([productId, sortOrder])
  @@map("product_images")
}

// ---------------------------------------------------------------------------
// Money
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

/// The four buttons on the buy panel.
enum PurchaseMethod {
  BUY_NOW // Mua Ngay
  DEPOSIT // Cọc / Góp
  TRADE_IN // Thu cũ đổi mới
  PAY_LATER // Tiêu trước trả sau
}

model Order {
  id          String         @id @default(cuid())
  /// Human-facing order code, shown in "Lịch sử mua".
  code        String         @unique
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  productId   String
  product     Product        @relation(fields: [productId], references: [id])

  /// Which tier was bought. Null on accounts, which have no tiers — an
  /// account is the whole thing or nothing.
  packageId   String?
  package     ProductPackage? @relation(fields: [packageId], references: [id])
  /// Accounts are one of a kind and always 1. Software sells in multiples, so
  /// the count is stored rather than inferred from the total, which would stop
  /// being recoverable the moment a voucher touched the figure.
  quantity    Int            @default(1)

  method      PurchaseMethod @default(BUY_NOW)
  status      OrderStatus    @default(PENDING)

  /// The checkout dialog itemises all of these, so all of them are stored —
  /// recomputing a historical total from the current product price would drift.
  listPrice   BigInt
  discountPct Int            @default(0)
  voucherId   String?
  voucher     Voucher?       @relation(fields: [voucherId], references: [id])
  voucherCut  BigInt         @default(0)
  total       BigInt

  createdAt   DateTime       @default(now())

  /// How many licence keys this order is entitled to, fixed at the sale.
  ///
  /// Not the same fact as `quantity`, which is what was bought: an account
  /// order and every software order placed before the shop kept keys owe
  /// nothing, and deriving the entitlement from quantity would put all of
  /// them in the queue the first time a tier was stocked.
  keysOwed    Int            @default(0)
  /// The keys handed over. Fewer than `keysOwed` while the tier is out of
  /// stock — that shortfall IS the shop's to-do list.
  licenseKeys LicenseKey[]

  @@index([userId, createdAt])
  @@map("orders")
}

/// Who a key is allowed to be: on the shelf, handed to a buyer, or withdrawn
/// by the shop without being sold (leaked, revoked upstream, typed wrong).
enum LicenseKeyStatus {
  AVAILABLE
  SOLD
  DISABLED
}

/// One licence key, in stock or delivered.
///
/// The shop pastes keys in per tier; a paid order takes them off the shelf in
/// the same transaction that charges for them. A sold key is never deleted —
/// it is the receipt for what a buyer was given, and the row is what says when
/// their access runs out.
model LicenseKey {
  id          String           @id @default(cuid())
  packageId   String
  package     ProductPackage   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  /// The key itself, verbatim.
  value       String
  status      LicenseKeyStatus @default(AVAILABLE)
  /// The shop's own note — which batch it came from, who supplied it.
  note        String?

  /// Set together, at the moment of delivery.
  orderId     String?
  order       Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  deliveredAt DateTime?
  /// Delivery plus the tier's duration. Null on a lifetime tier — and null
  /// while the key is still on the shelf, because a key nobody holds is not
  /// counting down.
  expiresAt   DateTime?

  createdAt   DateTime         @default(now())

  /// The same key twice in one tier is a paste that ran twice, not two goods.
  @@unique([packageId, value])
  /// How the shelf is read: this tier's stock, oldest first.
  @@index([packageId, status, createdAt])
  @@index([orderId])
  @@map("license_keys")
}

model Voucher {
  id          String    @id @default(cuid())
  code        String    @unique
  percentOff  Int?
  amountOff   BigInt?
  /// Order subtotal a cart must reach before the code applies.
  minOrder    BigInt?
  /// Codes can be created ahead of a campaign; null means live now.
  startsAt    DateTime?
  maxUses     Int?
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  active      Boolean   @default(true)
  orders      Order[]

  @@map("vouchers")
}

/// What still has to happen after a spin resolves.
enum SpinWinStatus {
  /// Nothing: points and money settled themselves inside the same transaction.
  NONE
  /// A prize the shop hands over by hand, waiting to be sent.
  PENDING
  /// Sent. Kept rather than deleted so a customer can be answered later.
  SENT
}

enum TransactionKind {
  TOPUP
  PURCHASE
  REFUND
  REWARD
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

/// Every spin the wheel has resolved.
///
/// Money and points are already in the user's row by the time this is written,
/// so for those this row is only a receipt. A physical prize is the reason the
/// table exists: nothing in the account can pay it out, so the row is what
/// tells the shop there is a parcel to send — and what stops "tôi trúng pad
/// chuột" from being an argument nobody can settle.
model SpinWin {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  /// The prize's stable id from the table the draw reads; the label is copied
  /// beside it because the table is code and can be retuned, while what this
  /// customer was promised cannot change afterwards.
  prizeId   String
  label     String
  kind      String
  amount    Int           @default(0)
  status    SpinWinStatus @default(NONE)
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("spin_wins")
}

/// /transactions renders "Biến động & Số dư" in one column, so each row carries
/// both the delta and the resulting balance. Storing only the delta would make
/// that column impossible to render without replaying the whole ledger.
model Transaction {
  id            String            @id @default(cuid())
  code          String            @unique
  userId        String
  user          User              @relation(fields: [userId], references: [id])

  kind          TransactionKind
  status        TransactionStatus @default(SUCCESS)
  /// Signed: negative for spend, positive for credit.
  delta         BigInt
  balanceAfter  BigInt
  description   String
  method        String?

  createdAt     DateTime          @default(now())

  @@index([userId, createdAt])
  @@map("transactions")
}

/// /wallet offers exactly two paths.
enum TopUpMethod {
  BANK // Ngân Hàng
  CARD // Thẻ Cào
}

enum TopUpStatus {
  PENDING
  COMPLETED
  /// Turned down by an admin.
  FAILED
  /// Nobody paid it within the window, so it left the queue on its own. Still
  /// creditable: a customer who transfers a day late is paying, not cheating,
  /// and the code in their description still identifies the request.
  EXPIRED
  /// Withdrawn by the customer before paying ("Hủy hóa đơn này"). Unlike
  /// EXPIRED it is never credited later — the settle path only takes
  /// PENDING and EXPIRED rows.
  CANCELLED
}

model TopUp {
  id        String      @id @default(cuid())
  code      String      @unique
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  method    TopUpMethod
  amount    BigInt
  status    TopUpStatus @default(PENDING)
  /// Carrier for CARD top-ups ("1. Chọn nhà mạng").
  carrier   String?
  /// The 1% its referrer earned when this was credited, if any.
  earning   ReferralEarning?
  createdAt DateTime    @default(now())

  @@index([userId, createdAt])
  /// The retirement sweep asks for pending rows older than a cutoff, and it
  /// now runs on every reconciliation pass rather than once a day. Without
  /// this it is a sequential scan of every top-up the shop has ever taken.
  @@index([status, createdAt])
  @@map("topups")
}

// ---------------------------------------------------------------------------
// Services (/services/*, "Đơn dịch vụ")
// ---------------------------------------------------------------------------

model Service {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  priceLabel  String?
  imageUrl    String?
  doneCount   Int            @default(0)
  /// Splits the two sections the live /services page renders: "Dịch Vụ Game"
  /// and "Dịch Vụ Khác". A column rather than a hard-coded slug list, so a new
  /// service lands in the right section without a deploy.
  isGameService Boolean      @default(false)
  updatedAt   DateTime       @updatedAt @default(now())
  orders      ServiceOrder[]

  @@map("services")
}

enum ServiceOrderStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

model ServiceOrder {
  id        String             @id @default(cuid())
  code      String             @unique
  userId    String
  user      User               @relation(fields: [userId], references: [id])
  serviceId String
  service   Service            @relation(fields: [serviceId], references: [id])
  status    ServiceOrderStatus @default(PENDING)
  amount    BigInt             @default(0)
  note      String?
  createdAt DateTime           @default(now())

  @@index([userId, createdAt])
  @@map("service_orders")
}

// ---------------------------------------------------------------------------
// Social proof (homepage)
// ---------------------------------------------------------------------------

model Feedback {
  id        String   @id @default(cuid())
  name      String
  avatarUrl String?
  body      String
  amount    BigInt   @default(0)
  verified  Boolean  @default(true)
  /// 1–5 stars. Seeded rows predate the field and were all praise, hence 5.
  rating    Int      @default(5)
  /// Chip text on the review card ("MUA KEY", "MUA ACC", "NẠP TIỀN", "KHÁC").
  service   String   @default("MUA KEY")
  /// Optional photo attached by the reviewer (a transfer bill, usually).
  imageUrl  String?
  /// The reviewer chose to hide their identity; display layers mask name and
  /// avatar, the stored values stay real so the admin can still see them.
  anonymous Boolean  @default(false)
  /// Visitor submissions start false and only an admin flips them on —
  /// seeded/legacy rows default true so they never vanish from the page.
  approved  Boolean  @default(true)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@map("feedback")
}

/// A scheduled discount on one product.
///
/// The homepage flash-sale row used to be derived from oldPrice > 0, which
/// meant every discounted product was on sale forever and nothing could be
/// scheduled or switched off. A row here has a window and an active flag.
model FlashSale {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Price during the sale. The product keeps its own price for afterwards.
  salePrice  BigInt
  startsAt   DateTime
  endsAt     DateTime
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([active, startsAt, endsAt])
  @@map("flash_sales")
}

// ---------------------------------------------------------------------------
// Shop configuration
// ---------------------------------------------------------------------------

/// One shop setting, addressed by a dotted key such as "topup.min".
///
/// A key-value row rather than a one-row settings table: a setting the shop
/// adds later is an insert, not a migration, and a key that has never been
/// written falls back to the default declared in src/lib/settings.ts. Values
/// are stored as text and parsed there, so the shape of a setting lives in
/// one place instead of being split between a column type and the code that
/// reads it.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @default(now())

  @@map("settings")
}

// ---------------------------------------------------------------------------
// System announcements
// ---------------------------------------------------------------------------

enum AnnouncementType {
  UPDATE
  MAINTENANCE
  PROMO
  INFO
  GIFT
}

/// Declaration order is load-bearing: `activeAnnouncements` sorts descending
/// on this column to put HIGH first, and Postgres sorts an enum by the order
/// its values were declared. Reordering these reverses that list.
enum AnnouncementPriority {
  LOW
  NORMAL
  HIGH
}

/// What the shop has decided about a notice, which is not the same as whether
/// a visitor sees it — that also depends on the window below.
enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  DISABLED
}

/// Who a notice is addressed to.
///
/// ALL reaches signed-out visitors too, which is what a maintenance warning
/// wants. USERS cannot: it is delivered by matching the reader's account
/// against the recipient rows, and a guest has none.
enum AnnouncementAudience {
  ALL
  USERS
}

/// One notice shown to visitors in a modal and listed under the header bell.
///
/// `body` is plain text and is rendered as text. Storing rich HTML here would
/// mean an admin account — or anything that reached one — could put a script
/// on every page of the site, and the notices this exists for ("bảo trì lúc
/// 2h", "đã sửa lỗi nạp tiền") need no markup to say.
model Announcement {
  id       String               @id @default(cuid())
  title    String
  body     String
  type     AnnouncementType     @default(INFO)
  priority AnnouncementPriority @default(NORMAL)
  status   AnnouncementStatus   @default(DRAFT)
  audience AnnouncementAudience @default(ALL)

  /// The "Lưu ý" list under the body. Separate from `body` rather than parsed
  /// out of it: a convention like "lines starting with a dash are bullets"
  /// turns a customer's hyphen into markup, and the shop cannot see why.
  bullets String[]

  /// The callout box at the foot of the notice. Both or neither — a box with
  /// a heading and no text is a rendering accident, not a notice.
  noticeTitle String?
  noticeBody  String?

  /// The window. `startAt <= now <= endAt` is the whole activeness test, so
  /// nothing has to run on a schedule to switch a notice on or off at the
  /// right moment. A null `endAt` means it runs until someone turns it off.
  startAt DateTime  @default(now())
  endAt   DateTime?

  /// Bumped whenever the wording changes, and part of the key a browser
  /// remembers a dismissal under. Without it, editing a notice everyone has
  /// already closed would reach nobody.
  revision Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipients AnnouncementRecipient[]

  /// Every visitor read filters on exactly these three.
  @@index([status, startAt, endAt])
  @@map("announcements")
}

/// One person a targeted notice is addressed to.
///
/// A join table rather than a list of ids on the announcement: this is what
/// makes "does this notice belong to the reader" an indexed lookup instead of
/// loading every targeted notice on the site and filtering in application
/// code. The composite key also makes naming somebody twice a no-op.
model AnnouncementRecipient {
  announcementId String
  userId         String

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([announcementId, userId])
  /// The direction the visitor query travels: given a reader, which notices.
  @@index([userId])
  @@map("announcement_recipients")
}